# Generate a unique host secret, then enter it on the controller page.
HOST_SECRET=replace-with-at-least-24-random-characters
PUBLIC_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Optional behind a reverse proxy: its exact private IP, never a CIDR or "true".
# Leave unset for direct/local access. The proxy must replace incoming forwarding headers.
# TRUSTED_PROXY_IP=172.30.0.2
# Optional until you register a Twitch developer application.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
